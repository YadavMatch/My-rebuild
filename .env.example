# Copy to .env and fill in from your Supabase project:
#   Project Settings -> API
#
# Both values are safe to ship inside the app. The anon key is designed to be
# public; row-level security is what actually protects the data.
#
# Never put the service_role key here or anywhere in this repo. It bypasses
# every policy in the schema, and any EXPO_PUBLIC_ variable is baked into the
# app bundle where anyone can read it.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
