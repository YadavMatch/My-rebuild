# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
# .env holds the Supabase keys for this machine and is never committed.
.env
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# Deno writes this when typechecking supabase/functions. It is generated
# against the whole npm tree, so it is noise rather than a useful lockfile.
deno.lock
