# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
# .env holds the Supabase keys for this machine and is never committed.
.env
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# A root-level deno.lock only appears if deno is run from the repository root,
# where it resolves against the whole npm tree and comes out as noise. The
# real, scoped lockfiles live beside each function's deno.json and ARE
# committed, so this pattern is deliberately anchored to the root.
/deno.lock
